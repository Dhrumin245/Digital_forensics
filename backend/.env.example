# Copy this file to .env and fill in real values before running.
# Never commit .env or any PEM key files to Git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forensics:forensics@localhost:5432/forensics

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM contents below, replacing newlines with \n
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CUSTODY=forensics.custody
KAFKA_TOPIC_AUDIT=forensics.audit
KAFKA_TOPIC_ALERTS=forensics.alerts

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_EVIDENCE=forensics-evidence
S3_BUCKET_AUDIT_MIRROR=forensics-audit-mirror

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Signing ───────────────────────────────────────────────────────────────────
SIGNING_KEY_ID=forensics-verify-key-v1

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_EVIDENCE_FILE_SIZE_BYTES=2147483648
VERIFY_RATE_LIMIT_PER_MINUTE=10
VERIFY_RATE_LIMIT_PER_HOUR=100
